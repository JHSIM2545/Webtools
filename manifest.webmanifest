{
  "name": "SIM Tools",
  "short_name": "SIM Tools",
  "description": "SIM 웹툴 런처 — 여러 툴을 선택해서 실행",
  "lang": "ko",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1117",
  "theme_color": "#0f1117",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "vcf",
          "accept": [
            "text/vcard",
            "text/x-vcard",
            "text/directory",
            ".vcf"
          ]
        },
        {
          "name": "ics",
          "accept": [
            "text/calendar",
            "text/x-vcalendar",
            "application/ics",
            ".ics",
            ".ical"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
